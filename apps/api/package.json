{
  "name": "@school-live/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:init": "node scripts/init-db.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/websockets": "^11.1.16",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
