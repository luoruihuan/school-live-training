DATABASE_URL="mysql://live:replace-with-local-password@127.0.0.1:3306/live_training_points"
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
# 回放保留天数（默认 180 天 = 6 个月）；过期对象由 API 定时清理。
RECORDING_RETENTION_DAYS=180
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-long-random-password"
# SRS 自建直播推流鉴权密钥（至少 16 位随机串）
SRS_SECRET="replace-with-a-long-random-secret"
# MinIO 对象存储（商品图与回放文件）
MINIO_ROOT_USER="live-storage"
MINIO_ROOT_PASSWORD="replace-with-a-long-random-password"
