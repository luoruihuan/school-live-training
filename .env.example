DATABASE_URL="mysql://live:replace-with-local-password@127.0.0.1:3306/live_training_points"
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
# 回放保留：默认最长 180 天（6 个月）；磁盘使用率 ≥ 高水位时提前清理最旧回放，
# 但创建未满最小保留天数的绝不提前删。
RECORDING_RETENTION_DAYS=180
RECORDING_MIN_RETENTION_DAYS=90
RECORDING_DISK_HIGH_WATERMARK=85
RECORDING_DISK_LOW_WATERMARK=75
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-long-random-password"
# SRS 自建直播推流鉴权密钥（至少 16 位随机串）
SRS_SECRET="replace-with-a-long-random-secret"
# MinIO 对象存储（商品图与回放文件）
MINIO_ROOT_USER="live-storage"
MINIO_ROOT_PASSWORD="replace-with-a-long-random-password"
# 回放长期层（可选）：配置后回放存腾讯 COS（同地域内网免流量费）；不配置则回放存 MinIO
# COS_ENDPOINT=https://cos.ap-tokyo.myqcloud.com
# COS_REGION=ap-tokyo
# COS_SECRET_ID=AKIDxxxxxxxx
# COS_SECRET_KEY=xxxxxxxx
# COS_RECORDINGS_BUCKET=live-recordings-125xxxxxxx
# CDN 分发（可选，全部留空即回退直连源站）：
#  CDN_LIVE_DOMAIN：直播加速域名（回源 https://APP_DOMAIN/live/*，观众从 CDN 边缘拉流）
#  REPLAY_CDN_DOMAIN：回放加速域名（绑 COS 桶，回放直连 CDN，不再经 API 代理）
#  CDN_URL_AUTH_KEY：回放 URL 鉴权密钥，与腾讯云 CDN 控制台 TypeA 主密钥保持一致
# CDN_LIVE_DOMAIN=live-cdn.example.com
# REPLAY_CDN_DOMAIN=replay-cdn.example.com
# CDN_URL_AUTH_KEY=replace-with-6-40-chars-key
