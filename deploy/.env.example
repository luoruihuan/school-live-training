APP_DOMAIN=classroom.example.com
# 两个独立随机十六进制密码：分别执行 openssl rand -hex 24。避免 URL 特殊字符。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# 默认证书目录 deploy/tls，文件名 fullchain.pem、privkey.pem。
COS_ENDPOINT=
COS_RECORDINGS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=

# 腾讯云 CSS（可选，说明见 deploy/tencent-css.md）
CSS_PUSH_DOMAIN=
CSS_PLAY_DOMAIN=
CSS_PUSH_PROTOCOL=rtmps
CSS_PUSH_KEY=
CSS_PLAY_KEY=
CSS_CALLBACK_KEY=
CSS_APP_ID=
# 自适应码率模板名（可选；需先在播放域名绑定同名模板，留空则 HLS 播放原始流）
CSS_ABR_TEMPLATE=
# 回放保留与清理：按保留期清理；回放存放在本机 MinIO 时，磁盘高于高水位会提前清理超过最小保留期的最旧回放
RECORDING_RETENTION_DAYS=30
# RECORDING_MIN_RETENTION_DAYS=90
# CDN 分发（可选，留空即直连源站）：直播加速域名、回放加速域名、回放 URL 鉴权密钥（与 CDN 控制台 TypeA 主密钥一致）
# CDN_LIVE_DOMAIN=
# REPLAY_CDN_DOMAIN=
# CDN_URL_AUTH_KEY=
# 运维告警（可选）：飞书机器人 webhook
# FEISHU_WEBHOOK_URL=

